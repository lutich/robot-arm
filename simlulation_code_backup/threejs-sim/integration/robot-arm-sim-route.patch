+# Optional three.js simulator from px-robotic-arm-sim (threejs-sim/), served read-only under /sim/
+# when ROBOT_ARM_SIM_DIR points at that folder. Same origin, so the simulator can read /api/state
+# and, after its operator explicitly enables live control, send the same actions as this page.
+SIM_TYPES = {'.html':'text/html; charset=utf-8', '.js':'text/javascript; charset=utf-8',
+             '.css':'text/css; charset=utf-8', '.json':'application/json', '.png':'image/png',
+             '.jpg':'image/jpeg', '.svg':'image/svg+xml', '.txt':'text/plain; charset=utf-8'}
+
+
+def sim_directory():
+    path = os.environ.get('ROBOT_ARM_SIM_DIR')
+    root = Path(path).resolve() if path else None
+    return root if root and (root / 'index.html').is_file() else None
+
+
+def sim_file(root, path):
+    file = (root / (path or 'index.html')).resolve()
+    if root not in file.parents or not file.is_file() or file.suffix not in SIM_TYPES:
+        raise HTTPException(404)
+    return Response(file.read_bytes(), media_type=SIM_TYPES[file.suffix])
+
